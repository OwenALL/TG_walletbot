# ==================== 数据库 ====================
DB_ROOT_PASSWORD=your_mysql_root_password
DB_NAME=tg_bot
DB_USER=root

# ==================== Redis ====================
REDIS_PASSWORD=

# ==================== JWT ====================
JWT_SECRET=your_jwt_secret_change_in_production

# ==================== Telegram Bot ====================
BOT_TOKEN=your_telegram_bot_token

# ==================== TRON 区块链 ====================
TRON_API_URL=https://api.trongrid.io
TRON_GRPC_ENDPOINT=grpc.trongrid.io:50051
TRON_API_KEY=your_trongrid_api_key
TRON_ENCRYPTION_KEY=your_aes256_encryption_key
TRON_HOT_WALLET_ADDRESS=
TRON_HOT_WALLET_ENCRYPTED_KEY=
TRON_ENABLED=false

# ==================== 应用 ====================
APP_ENV=development
APP_DEBUG=true
API_PORT=8080
